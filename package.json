{
  "name": "tampilkit-ac-booking",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @tampilkit-ac/frontend\" \"npm run dev -w @tampilkit-ac/backend\"",
    "dev:frontend": "npm run dev -w @tampilkit-ac/frontend",
    "dev:backend": "npm run dev -w @tampilkit-ac/backend",
    "build": "npm run build -w @tampilkit-ac/api-contract && npm run build -w @tampilkit-ac/backend && npm run build -w @tampilkit-ac/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @tampilkit-ac/backend",
    "db:migrate": "npm run db:migrate -w @tampilkit-ac/backend",
    "db:deploy": "npm run db:deploy -w @tampilkit-ac/backend",
    "db:seed": "npm run db:seed -w @tampilkit-ac/backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3"
  }
}
