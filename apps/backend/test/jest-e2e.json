{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(jose)/)"
  ],
  "testEnvironment": "node",
  "testTimeout": 30000,
  "moduleNameMapper": {
    "^@tampilkit-ac/api-contract$": "<rootDir>/../../../packages/api-contract/src"
  }
}
