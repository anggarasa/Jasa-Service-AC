datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  ADMIN
  TECHNICIAN
}

enum PriceType {
  FIXED
  STARTING_FROM
  INSPECTION_REQUIRED
}

enum PricingUnit {
  PER_UNIT
  PER_VISIT
  INSPECTION
}

enum MediaPurpose {
  BUSINESS_LOGO
  SERVICE_IMAGE
  GALLERY_IMAGE
  AC_UNIT_PHOTO
  WORK_ORDER_PHOTO
  PAYMENT_PROOF
  APPROVAL_EVIDENCE
}

enum AcType {
  SPLIT
  CASSETTE
  FLOOR_STANDING
  CENTRAL
  WINDOW
  PORTABLE
  OTHER
}

enum CustomerAuditAction {
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  CUSTOMER_ARCHIVED
  ADDRESS_CREATED
  ADDRESS_UPDATED
  PRIMARY_ADDRESS_CHANGED
  ADDRESS_ARCHIVED
  AC_UNIT_CREATED
  AC_UNIT_UPDATED
  AC_UNIT_MOVED
  AC_UNIT_ARCHIVED
  AC_UNIT_PHOTO_ADDED
  AC_UNIT_PHOTO_REMOVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
  EXPIRED
  NO_SHOW
}

enum WorkOrderStatus {
  DRAFT
  SCHEDULED
  ASSIGNED
  ON_THE_WAY
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FOLLOW_UP_REQUIRED
}

enum InspectionStatus {
  NOT_INSPECTED
  GOOD
  NEEDS_SERVICE
  REPAIR_REQUIRED
  CRITICAL
}

enum ChecklistItemStatus {
  NOT_STARTED
  DONE
  NOT_APPLICABLE
  NEEDS_ATTENTION
}

enum WorkOrderPhotoCategory {
  BEFORE
  DURING
  AFTER
  ISSUE
}

enum AuthAuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  TOKEN_REFRESH
  TOKEN_REUSE_DETECTED
  LOGOUT
  LOGOUT_ALL
  SESSION_REVOKED
  PASSWORD_CHANGED
  ACCESS_DENIED
  ACCOUNT_DISABLED
}

model User {
  id                String         @id @default(uuid())
  name              String
  email             String         @unique
  passwordHash      String
  role              UserRole       @default(TECHNICIAN)
  isActive          Boolean        @default(true)
  tokenVersion      Int            @default(1)
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sessions          AuthSession[]
  auditLogs         AuthAuditLog[]
  technician        Technician?
  mediaAssets       MediaAsset[]

  @@index([email])
}

model AuthSession {
  id                String               @id @default(uuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId          String               @default(uuid())
  userAgent         String?
  ipAddress         String?
  createdAt         DateTime             @default(now())
  lastUsedAt        DateTime             @default(now())
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  revokedReason     String?
  refreshTokens     RefreshTokenRecord[]
  auditLogs         AuthAuditLog[]

  @@index([userId, revokedAt])
  @@index([familyId])
}

model RefreshTokenRecord {
  id            String      @id @default(uuid())
  sessionId     String
  session       AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  jti           String      @unique
  tokenHash     String      @unique
  issuedAt      DateTime    @default(now())
  expiresAt     DateTime
  consumedAt    DateTime?
  replacedByJti String?
  revokedAt     DateTime?

  @@index([sessionId, consumedAt])
  @@index([tokenHash])
}

model AuthAuditLog {
  id        String             @id @default(uuid())
  userId    String?
  user      User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?
  session   AuthSession?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  eventType AuthAuditEventType
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime           @default(now())

  @@index([userId, eventType])
  @@index([createdAt])
}

model RateLimitRecord {
  id        String   @id @default(uuid())
  key       String   @unique
  points    Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key, expiresAt])
}

model Business {
  id                  String                   @id @default(uuid())
  name                String
  slug                String                   @unique
  description         String?
  email               String
  phone               String
  whatsappNumber      String
  address             String
  city                String                   @default("Jakarta Selatan")
  province            String                   @default("DKI Jakarta")
  postalCode          String?                  @default("12160")
  googleMapsUrl       String?
  timezone            String                   @default("Asia/Jakarta")
  logoObjectKey       String?
  isActive            Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  settings            BusinessSetting?
  operatingHours      BusinessOperatingHour[]
  closures            BusinessClosure[]
  categories          ServiceCategory[]
  services            Service[]
  serviceAreas        ServiceArea[]
  mediaAssets         MediaAsset[]
  gallery             BusinessGallery[]
  customers           Customer[]
  customerAuditLogs   CustomerAuditLog[]
  technicians         Technician[]
  bookings            Booking[]
  workOrders          WorkOrder[]
  checklistTemplates  ServiceChecklistTemplate[]
  calendarConnections CalendarConnection[]
  invoices            Invoice[]
  payments            Payment[]
  financialAuditLogs  FinancialAuditLog[]

  @@index([slug])
}

model BusinessSetting {
  id                          String   @id @default(uuid())
  businessId                  String   @unique
  business                    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookingEnabled              Boolean  @default(true)
  bookingIntervalMinutes      Int      @default(30)
  defaultServiceBufferMinutes Int      @default(15)
  defaultTravelBufferMinutes  Int      @default(30)
  minimumAdvanceMinutes       Int      @default(120)
  maximumAdvanceDays          Int      @default(30)
  autoConfirmBooking          Boolean  @default(false)
  allowCustomerCancellation   Boolean  @default(false)
  cancellationWindowHours     Int      @default(24)
  maximumUnitsPerBooking      Int      @default(5)
  pendingHoldMinutes          Int      @default(120)
  currency                    String   @default("IDR")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model BusinessOperatingHour {
  id           String                   @id @default(uuid())
  businessId   String
  business     Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek    Int // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  isOpen       Boolean                  @default(true)
  openTime     String                   @default("09:00") // HH:mm local wall-clock
  closeTime    String                   @default("17:00")
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  breaks       BusinessOperatingBreak[]

  @@unique([businessId, dayOfWeek])
  @@index([businessId, dayOfWeek])
}

model BusinessOperatingBreak {
  id              String                @id @default(uuid())
  operatingHourId String
  operatingHour   BusinessOperatingHour @relation(fields: [operatingHourId], references: [id], onDelete: Cascade)
  startTime       String                @default("12:00") // HH:mm
  endTime         String                @default("13:00") // HH:mm
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([operatingHourId])
}

model BusinessClosure {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  startDate  DateTime
  endDate    DateTime
  reason     String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, startDate, endDate])
}

model ServiceCategory {
  id           String    @id @default(uuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  description  String?
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  services     Service[]

  @@unique([businessId, slug])
  @@index([businessId, displayOrder])
}

model Service {
  id                       String          @id @default(uuid())
  businessId               String
  business                 Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId               String
  category                 ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name                     String
  slug                     String
  shortDescription         String?
  description              String
  priceType                PriceType       @default(STARTING_FROM)
  basePrice                Decimal?        @db.Decimal(12, 2)
  pricingUnit              PricingUnit     @default(PER_UNIT)
  estimatedDurationMinutes Int             @default(60)
  additionalBufferMinutes  Int             @default(0)
  minimumUnits             Int             @default(1)
  maximumUnits             Int             @default(10)
  imageObjectKey           String?
  displayOrder             Int             @default(0)
  isActive                 Boolean         @default(true)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  bookings                 Booking[]
  checklistTemplates       ServiceChecklistTemplate[]

  @@unique([businessId, slug])
  @@index([businessId, isActive, displayOrder])
}

model ServiceArea {
  id                     String            @id @default(uuid())
  businessId             String
  business               Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                   String
  province               String            @default("DKI Jakarta")
  city                   String
  district               String
  visitFee               Decimal           @default(0) @db.Decimal(12, 2)
  estimatedTravelMinutes Int               @default(30)
  displayOrder           Int               @default(0)
  isActive               Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  addresses              CustomerAddress[]
  bookings               Booking[]

  @@unique([businessId, name])
  @@index([businessId, city, district])
}

model MediaAsset {
  id              String            @id @default(uuid())
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  objectKey       String            @unique
  bucket          String            @default("tampilkit-ac-booking")
  mimeType        String
  fileSize        Int
  width           Int?
  height          Int?
  purpose         MediaPurpose
  createdByUserId String?
  createdByUser   User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  galleryItems    BusinessGallery[]
  acUnitMedia       AcUnitMedia[]
  workOrderPhotos   WorkOrderPhoto[]
  approvalEvidences ServiceChargeApproval[] @relation("ApprovalEvidenceMedia")
  paymentProofs     Payment[]               @relation("PaymentProofMedia")

  @@index([businessId, purpose])
}

model BusinessGallery {
  id           String     @id @default(uuid())
  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  caption      String?
  altText      String?
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([businessId, isActive, displayOrder])
}

model Customer {
  id              String             @id @default(uuid())
  businessId      String
  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerCode    String
  name            String
  phone           String
  normalizedPhone String
  displayPhone    String?
  email           String?
  notes           String?
  isActive        Boolean            @default(true)
  archivedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  addresses       CustomerAddress[]
  acUnits         AcUnit[]
  bookings        Booking[]
  workOrders      WorkOrder[]
  auditLogs       CustomerAuditLog[]
  invoices        Invoice[]

  @@unique([businessId, customerCode])
  @@index([businessId, normalizedPhone])
  @@index([businessId, name])
  @@index([businessId, isActive])
}

model CustomerAddress {
  id             String      @id @default(uuid())
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label          String
  recipientName  String?
  recipientPhone String?
  fullAddress    String
  province       String      @default("DKI Jakarta")
  city           String
  district       String
  subdistrict    String?
  postalCode     String?
  landmark       String?
  serviceAreaId  String?
  serviceArea    ServiceArea? @relation(fields: [serviceAreaId], references: [id], onDelete: SetNull)
  latitude       Decimal?    @db.Decimal(10, 7)
  longitude      Decimal?    @db.Decimal(10, 7)
  isPrimary      Boolean     @default(false)
  isActive       Boolean     @default(true)
  archivedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  acUnits        AcUnit[]
  bookings       Booking[]
  workOrders     WorkOrder[]

  @@unique([id, customerId])
  @@index([customerId, isActive])
  @@index([serviceAreaId])
}

model AcUnit {
  id                 String          @id @default(uuid())
  customerId         String
  customer           Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerAddressId  String
  customerAddress    CustomerAddress @relation(fields: [customerAddressId, customerId], references: [id, customerId], onDelete: Restrict)
  unitCode           String          @unique
  unitLabel          String
  brand              String
  model              String?
  type               AcType          @default(SPLIT)
  capacityPk         Decimal         @db.Decimal(4, 2)
  serialNumber       String?
  installationRoom   String?
  installationDate   DateTime?
  notes              String?
  isActive           Boolean         @default(true)
  archivedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  photos             AcUnitMedia[]
  bookingUnits       BookingAcUnit[]
  bookingItems       BookingItem[]
  workOrderItems     WorkOrderItem[]
  inspections        WorkOrderUnitInspection[]

  @@index([customerId, isActive])
  @@index([customerAddressId])
}

model AcUnitMedia {
  id           String     @id @default(uuid())
  acUnitId     String
  acUnit       AcUnit     @relation(fields: [acUnitId], references: [id], onDelete: Cascade)
  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  caption      String?
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([acUnitId, mediaAssetId])
  @@index([acUnitId, displayOrder])
}

model CustomerAuditLog {
  id           String              @id @default(uuid())
  businessId   String
  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  actorUserId  String?
  action       CustomerAuditAction
  changedFields Json?
  reason       String?
  createdAt    DateTime            @default(now())

  @@index([customerId, createdAt])
  @@index([businessId, action])
}

model Technician {
  id               String              @id @default(uuid())
  businessId       String
  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId           String              @unique
  user             User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  assignedBookings Booking[]
  workOrders       WorkOrder[]
  occupancies      ResourceOccupancy[]
  blocks           TechnicianBlock[]

  @@index([businessId, isActive])
}

model Booking {
  id                       String                 @id @default(uuid())
  businessId               String
  business                 Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customerId               String
  customer                 Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerAddressId        String
  customerAddress          CustomerAddress        @relation(fields: [customerAddressId], references: [id], onDelete: Restrict)
  serviceAreaId            String?
  serviceArea              ServiceArea?           @relation(fields: [serviceAreaId], references: [id], onDelete: SetNull)
  serviceId                String
  service                  Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  technicianId             String?
  technician               Technician?            @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  bookingCode              String                 @unique
  bookingSource            String                 @default("WEBSITE")
  status                   BookingStatus          @default(PENDING)
  scheduledStartAt         DateTime
  scheduledEndAt           DateTime
  occupancyStartAt         DateTime?
  occupancyEndAt           DateTime?
  serviceNameSnapshot      String?
  priceTypeSnapshot        PriceType?
  unitCount                Int                    @default(1)
  estimatedPrice           Decimal                @default(0) @db.Decimal(12, 2)
  estimatedServicePrice    Decimal?               @db.Decimal(12, 2)
  visitFeeSnapshot         Decimal                @default(0) @db.Decimal(12, 2)
  estimatedTotal           Decimal?               @db.Decimal(12, 2)
  estimatedDurationMinutes Int?
  customerNotes            String?
  rejectionReason          String?
  cancellationReason       String?
  internalNotes            String?
  rescheduleCount          Int                    @default(0)
  expiresAt                DateTime?
  cancelledAt              DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  workOrders               WorkOrder[]
  bookingUnits             BookingAcUnit[]
  bookingItems             BookingItem[]
  statusHistory            BookingStatusHistory[]
  auditLogs                BookingAuditLog[]
  accessTokens             BookingAccessToken[]
  occupancies              ResourceOccupancy[]
  idempotencies            BookingIdempotency[]
  calendarEventMapping     CalendarEventMapping?
  calendarConflicts        CalendarSyncConflict[]
  invoices                 Invoice[]

  @@index([businessId, status])
  @@index([scheduledStartAt])
  @@index([bookingCode])
  @@index([expiresAt])
}

model BookingItem {
  id                       String   @id @default(uuid())
  bookingId                String
  booking                  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  acUnitId                 String?
  acUnit                   AcUnit?  @relation(fields: [acUnitId], references: [id], onDelete: SetNull)
  brandSnapshot            String?
  modelSnapshot            String?
  typeSnapshot             AcType   @default(SPLIT)
  capacityPkSnapshot       Decimal? @db.Decimal(4, 2)
  installationRoomSnapshot String?
  serviceId                String
  unitPriceSnapshot        Decimal? @db.Decimal(12, 2)
  estimatedDurationMinutes Int      @default(60)
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([bookingId])
  @@index([acUnitId])
}

model BookingStatusHistory {
  id          String         @id @default(uuid())
  bookingId   String
  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus  BookingStatus?
  toStatus    BookingStatus
  reason      String?
  actorUserId String?
  createdAt   DateTime       @default(now())

  @@index([bookingId, createdAt])
}

model BookingAccessToken {
  id        String    @id @default(uuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash, expiresAt])
  @@index([bookingId])
}

model BookingIdempotency {
  id                 String   @id @default(uuid())
  businessId         String
  keyHash            String   @unique
  requestFingerprint String
  bookingId          String?
  booking            Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  responsePayload    Json?
  state              String   @default("IN_PROGRESS")
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([keyHash])
  @@index([expiresAt])
}

model ResourceOccupancy {
  id           String     @id @default(uuid())
  businessId   String
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  bookingId    String?
  booking      Booking?   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  startsAt     DateTime
  endsAt       DateTime
  status       String     @default("ACTIVE")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([technicianId, status, startsAt, endsAt])
  @@index([bookingId])
}

model TechnicianBlock {
  id           String     @id @default(uuid())
  businessId   String
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  startsAt     DateTime
  endsAt       DateTime
  reason       String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([technicianId, isActive, startsAt, endsAt])
}

model BookingAcUnit {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  acUnitId  String
  acUnit    AcUnit   @relation(fields: [acUnitId], references: [id], onDelete: Restrict)
  notes     String?
  createdAt DateTime @default(now())

  @@unique([bookingId, acUnitId])
}

model WorkOrder {
  id                         String                       @id @default(uuid())
  workOrderNumber            String                       @unique
  businessId                 String
  business                   Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookingId                  String
  booking                    Booking                      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customerId                 String
  customer                   Customer                     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerAddressId          String
  customerAddress            CustomerAddress              @relation(fields: [customerAddressId], references: [id], onDelete: Restrict)
  technicianId               String?
  technician                 Technician?                  @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  status                     WorkOrderStatus              @default(SCHEDULED)
  scheduledStartAt           DateTime
  scheduledEndAt             DateTime
  serviceSummarySnapshot     String?
  customerComplaintSnapshot  String?
  adminInstructions          String?
  diagnosis                  String?
  technicianNotes            String?
  arrivedAt                  DateTime?
  startedAt                  DateTime?
  completedAt                DateTime?
  cancelledAt                DateTime?
  cancellationReason         String?
  followUpReason             String?
  followUpNotes              String?
  createdByUserId            String?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  items                      WorkOrderItem[]
  statusHistory              WorkOrderStatusHistory[]
  assignmentHistory          WorkOrderAssignmentHistory[]
  inspections                WorkOrderUnitInspection[]
  checklistItems             WorkOrderChecklistItem[]
  photos                     WorkOrderPhoto[]
  serviceReport              WorkOrderServiceReport?
  charges                    WorkOrderCharge[]
  materials                  WorkOrderMaterial[]
  chargeApprovals            ServiceChargeApproval[]
  invoice                    Invoice?

  @@index([businessId, status])
  @@index([bookingId])
  @@index([customerId])
  @@index([technicianId, status])
  @@index([scheduledStartAt])
}

model WorkOrderItem {
  id                  String    @id @default(uuid())
  workOrderId         String
  workOrder           WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  acUnitId            String?
  acUnit              AcUnit?   @relation(fields: [acUnitId], references: [id], onDelete: SetNull)
  serviceId           String
  serviceNameSnapshot String
  unitPriceSnapshot   Decimal   @db.Decimal(12, 2)
  quantity            Int       @default(1)
  itemTotal           Decimal   @db.Decimal(12, 2)
  actionNotes         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  inspection          WorkOrderUnitInspection?
  checklistItems      WorkOrderChecklistItem[]
  photos              WorkOrderPhoto[]
  charges             WorkOrderCharge[]
  materials           WorkOrderMaterial[]

  @@index([workOrderId])
  @@index([acUnitId])
}

model WorkOrderStatusHistory {
  id          String           @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  fromStatus  WorkOrderStatus?
  toStatus    WorkOrderStatus
  reason      String?
  actorUserId String?
  createdAt   DateTime         @default(now())

  @@index([workOrderId, createdAt])
}

model WorkOrderAssignmentHistory {
  id               String    @id @default(uuid())
  workOrderId      String
  workOrder        WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  fromTechnicianId String?
  toTechnicianId   String?
  reason           String?
  actorUserId      String?
  createdAt        DateTime  @default(now())

  @@index([workOrderId, createdAt])
}

model BookingAuditLog {
  id          String         @id @default(uuid())
  bookingId   String
  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorUserId String?
  action      String
  fromStatus  BookingStatus?
  toStatus    BookingStatus?
  details     Json?
  createdAt   DateTime       @default(now())

  @@index([bookingId, createdAt])
}

model CalendarConnection {
  id                    String                   @id @default(uuid())
  businessId            String
  business              Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider              String                   @default("GOOGLE")
  googleAccountEmail    String?
  calendarId            String?
  calendarName          String?
  calendarTimezone      String?
  encryptedRefreshToken String?
  encryptedAccessToken  String?
  accessTokenExpiresAt  DateTime?
  grantedScopes         String[]                 @default([])
  status                String                   @default("DISCONNECTED")
  lastSuccessfulSyncAt  DateTime?
  lastErrorAt           DateTime?
  lastError             String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  eventMappings         CalendarEventMapping[]
  syncState             CalendarSyncState?
  webhookChannels       CalendarWebhookChannel[]
  syncJobs              CalendarSyncJob[]
  conflicts             CalendarSyncConflict[]
  externalEvents        ExternalCalendarEvent[]

  @@index([businessId])
}

model CalendarEventMapping {
  id                  String             @id @default(uuid())
  calendarConnectionId String
  calendarConnection  CalendarConnection @relation(fields: [calendarConnectionId], references: [id], onDelete: Cascade)
  bookingId           String?            @unique
  booking             Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  resourceBlockId     String?
  externalEventId     String
  externalEventEtag   String?
  aggregateVersion    Int                @default(1)
  syncStatus          String             @default("SYNCED")
  lastSyncedAt        DateTime           @default(now())
  lastError           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([calendarConnectionId, externalEventId])
  @@index([calendarConnectionId, syncStatus])
  @@index([bookingId])
}

model CalendarSyncState {
  id                     String             @id @default(uuid())
  connectionId           String             @unique
  connection             CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  nextSyncToken          String?
  lastFullSyncAt         DateTime?
  lastIncrementalSyncAt  DateTime?
  lastSuccessfulSyncAt   DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

model CalendarWebhookChannel {
  id                     String             @id @default(uuid())
  connectionId           String
  connection             CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  channelId              String             @unique
  resourceId             String
  verificationTokenHash  String
  expiresAt              DateTime
  status                 String             @default("ACTIVE")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([connectionId, status])
  @@index([expiresAt])
}

model CalendarSyncJob {
  id               String             @id @default(uuid())
  connectionId     String
  connection       CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  aggregateType    String
  aggregateId      String
  operation        String
  aggregateVersion Int                @default(1)
  status           String             @default("PENDING")
  attemptCount     Int                @default(0)
  nextAttemptAt    DateTime           @default(now())
  lockedUntil      DateTime?
  lockedBy         String?
  lastError        String?
  payload          Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status, nextAttemptAt])
  @@index([connectionId, status])
  @@index([aggregateType, aggregateId])
}

model CalendarSyncConflict {
  id                String             @id @default(uuid())
  connectionId      String
  connection        CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  bookingId         String?
  booking           Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  externalEventId   String?
  conflictType      String
  localSnapshot     Json?
  remoteSnapshot    Json?
  status            String             @default("OPEN")
  detectedAt        DateTime           @default(now())
  resolvedAt        DateTime?
  resolvedByUserId  String?
  resolutionNotes   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([connectionId, status])
  @@index([bookingId])
}

model ExternalCalendarEvent {
  id             String             @id @default(uuid())
  connectionId   String
  connection     CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  eventId        String
  etag           String?
  summary        String?
  startAt        DateTime
  endAt          DateTime
  isBusy         Boolean            @default(true)
  isAllDay       Boolean            @default(false)
  sourceType     String             @default("EXTERNAL_BUSY")
  lastObservedAt DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([connectionId, eventId])
  @@index([connectionId, startAt, endAt])
  @@index([sourceType])
}

model WorkOrderUnitInspection {
  id                String           @id @default(uuid())
  workOrderId       String
  workOrder         WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderItemId   String           @unique
  workOrderItem     WorkOrderItem    @relation(fields: [workOrderItemId], references: [id], onDelete: Cascade)
  acUnitId          String?
  acUnit            AcUnit?          @relation(fields: [acUnitId], references: [id], onDelete: SetNull)
  inspectionStatus  InspectionStatus @default(NOT_INSPECTED)
  reportedComplaint String?
  observedCondition String?
  diagnosis         String?
  recommendedAction String?
  requiresFollowUp  Boolean          @default(false)
  inspectedAt       DateTime         @default(now())
  inspectedByUserId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([workOrderId])
  @@index([workOrderItemId])
}

model ServiceChecklistTemplate {
  id          String                         @id @default(uuid())
  businessId  String
  business    Business                       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service?                       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  name        String
  isActive    Boolean                        @default(true)
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt
  items       ServiceChecklistTemplateItem[]

  @@index([businessId, serviceId])
}

model ServiceChecklistTemplateItem {
  id           String                   @id @default(uuid())
  templateId   String
  template     ServiceChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label        String
  description  String?
  isRequired   Boolean                  @default(true)
  displayOrder Int                      @default(0)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([templateId, displayOrder])
}

model WorkOrderChecklistItem {
  id                  String              @id @default(uuid())
  workOrderId         String
  workOrder           WorkOrder           @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderItemId     String
  workOrderItem       WorkOrderItem       @relation(fields: [workOrderItemId], references: [id], onDelete: Cascade)
  templateItemId      String?
  labelSnapshot       String
  descriptionSnapshot String?
  isRequiredSnapshot  Boolean             @default(true)
  status              ChecklistItemStatus @default(NOT_STARTED)
  completedAt         DateTime?
  completedByUserId   String?
  notes               String?
  displayOrder        Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([workOrderId])
  @@index([workOrderItemId])
}

model WorkOrderPhoto {
  id               String                 @id @default(uuid())
  workOrderId      String
  workOrder        WorkOrder              @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderItemId  String?
  workOrderItem    WorkOrderItem?         @relation(fields: [workOrderItemId], references: [id], onDelete: SetNull)
  mediaAssetId     String
  mediaAsset       MediaAsset             @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  category         WorkOrderPhotoCategory @default(BEFORE)
  caption          String?
  uploadedByUserId String
  createdAt        DateTime               @default(now())
  deletedAt        DateTime?

  @@index([workOrderId, category])
  @@index([workOrderItemId])
}

model WorkOrderServiceReport {
  id                   String    @id @default(uuid())
  workOrderId          String    @unique
  workOrder            WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  summary              String
  workPerformed        String
  issuesFound          String?
  recommendations      String?
  customerSignedName   String?
  technicianSignedName String?
  isCompleted          Boolean   @default(false)
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([workOrderId])
}

model WorkOrderCharge {
  id               String         @id @default(uuid())
  workOrderId      String
  workOrder        WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderItemId  String?
  workOrderItem    WorkOrderItem? @relation(fields: [workOrderItemId], references: [id], onDelete: SetNull)
  lineType         String
  description      String
  quantity         Decimal        @default(1) @db.Decimal(10, 2)
  unitPrice        Decimal        @default(0) @db.Decimal(12, 2)
  lineAmount       Decimal        @default(0) @db.Decimal(12, 2)
  currency         String         @default("IDR")
  status           String         @default("DRAFT")
  proposedByUserId String?
  approvedByUserId String?
  approvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([workOrderId])
  @@index([workOrderId, status])
}

model WorkOrderMaterial {
  id               String         @id @default(uuid())
  workOrderId      String
  workOrder        WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderItemId  String?
  workOrderItem    WorkOrderItem? @relation(fields: [workOrderItemId], references: [id], onDelete: SetNull)
  materialName     String
  quantity         Decimal        @db.Decimal(10, 2)
  unit             String
  unitPrice        Decimal        @db.Decimal(12, 2)
  totalAmount      Decimal        @db.Decimal(12, 2)
  notes            String?
  recordedByUserId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([workOrderId])
}

model ServiceChargeApproval {
  id                      String      @id @default(uuid())
  workOrderId             String
  workOrder               WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  pricingVersion          Int         @default(1)
  proposedTotal           Decimal     @db.Decimal(12, 2)
  approvedTotal           Decimal?    @db.Decimal(12, 2)
  status                  String      @default("DRAFT")
  approvalMethod          String      @default("IN_PERSON")
  approvalEvidenceMediaId String?
  approvalEvidenceMedia   MediaAsset? @relation("ApprovalEvidenceMedia", fields: [approvalEvidenceMediaId], references: [id], onDelete: SetNull)
  approvedByName          String?
  approvedByContact       String?
  approvedAt              DateTime?
  recordedByUserId        String?
  internalNotes           String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@index([workOrderId])
  @@index([workOrderId, status])
}

model Invoice {
  id                 String        @id @default(uuid())
  businessId         String
  business           Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookingId          String
  booking            Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  workOrderId        String        @unique
  workOrder          WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  invoiceNumber      String        @unique
  customerId         String
  customer           Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status             String        @default("DRAFT")
  currency           String        @default("IDR")
  subtotal           Decimal       @default(0) @db.Decimal(12, 2)
  discountTotal      Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal           Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal         Decimal       @default(0) @db.Decimal(12, 2)
  verifiedPaidTotal  Decimal       @default(0) @db.Decimal(12, 2)
  outstandingBalance Decimal       @default(0) @db.Decimal(12, 2)
  issuedAt           DateTime?
  dueAt              DateTime?
  paidAt             DateTime?
  cancelledAt        DateTime?
  voidReason         String?
  createdByUserId    String?
  version            Int           @default(1)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  items              InvoiceItem[]
  payments           Payment[]

  @@index([businessId, status])
  @@index([customerId])
  @@index([bookingId])
  @@index([invoiceNumber])
  @@index([issuedAt])
}

model InvoiceItem {
  id                  String   @id @default(uuid())
  invoiceId           String
  invoice             Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineType            String
  descriptionSnapshot String
  quantity            Decimal  @db.Decimal(10, 2)
  unitPrice           Decimal  @db.Decimal(12, 2)
  lineTotal           Decimal  @db.Decimal(12, 2)
  createdAt           DateTime @default(now())

  @@index([invoiceId])
}

model Payment {
  id                 String          @id @default(uuid())
  businessId         String
  business           Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceId          String
  invoice            Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paymentReference   String          @unique
  method             String
  amount             Decimal         @db.Decimal(12, 2)
  currency           String          @default("IDR")
  status             String          @default("PENDING_VERIFICATION")
  paidAtClaimed      DateTime?
  recordedAt         DateTime        @default(now())
  recordedByUserId   String?
  verifiedAt         DateTime?
  verifiedByUserId   String?
  rejectionReason    String?
  notes              String?
  idempotencyKeyHash String?         @unique
  proofMediaId       String?
  proofMedia         MediaAsset?     @relation("PaymentProofMedia", fields: [proofMediaId], references: [id], onDelete: SetNull)
  receipt            PaymentReceipt?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([businessId, status])
  @@index([invoiceId])
  @@index([recordedAt])
}

model PaymentReceipt {
  id            String   @id @default(uuid())
  paymentId     String   @unique
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  receiptNumber String   @unique
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
}

model FinancialAuditLog {
  id                String   @id @default(uuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  aggregateType     String
  aggregateId       String
  action            String
  performedByUserId String?
  previousState     Json?
  newState          Json?
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([businessId, aggregateType, aggregateId])
  @@index([createdAt])
}

